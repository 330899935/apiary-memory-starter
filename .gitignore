*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
data/
keys/
.env
.env.*
*.log

# Virtual environments and caches
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/

# OS noise
.DS_Store
Thumbs.db

